# ws-judge-core · 一体容器环境变量模板（服务端侧；任何 Token 绝不写入代码/前端/镜像）
# 复制为 .env 后按部署方式注入（docker run -e / 编排平台密钥变量）。

# ── 服务端唯一测试 Token（必填；代理代持 + Core 校验 双端注入，浏览器零持有）──
REAL_API_TOKEN=请替换为服务端唯一测试Token
FITCORE_HTTP_API_TOKEN=请替换为服务端唯一测试Token

# ── 隔离 Core（容器内 loopback，公网不可直达）──
DATABASE_URL=sqlite:////data/fitcore.db
MODEL_PROVIDER=fake
CORE_PORT=8001
AUDIO_WORKER_ENABLED=true
AUDIO_TEST_SOURCE_TRUSTED=true
AUDIO_WORKER_POLL_SECONDS=0.05
AUDIO_WORKER_RETRY_SECONDS=0.05
AUDIO_WORKER_MAX_ATTEMPTS=2

# ── 对外代理 ──
PROXY_PORT=80
REAL_API_BASE=http://127.0.0.1:8001
# 上传限制：multipart 整包 ≤ 7MB+64KB、WAV ≤ 7MB（上游 4797485 内置，无需配置）
